# Credenciales OAuth del proyecto en Google Cloud Console
# (Tipo de cliente OAuth: "Aplicación de escritorio")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Se obtiene una sola vez ejecutando: npm run get-refresh-token
GOOGLE_REFRESH_TOKEN=

# Calendario donde se crea el evento. "primary" = tu calendario principal.
GOOGLE_CALENDAR_ID=primary

# Tu correo, para que quedes como organizador/invitado y te llegue la alerta.
OWNER_EMAIL=tucorreo@ejemplo.com

# Zona horaria usada para calcular "ahora + 20 minutos"
TIMEZONE=America/Bogota
